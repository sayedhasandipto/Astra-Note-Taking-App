{
  "expo": {
    "name": "Astra",
    "slug": "astra-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F1A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sayedhasandipto.astra"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B0F1A"
      },
      "package": "com.sayedhasandipto.astra",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a905dabd-3233-4db8-8acf-293a056a9b67"
      }
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}
